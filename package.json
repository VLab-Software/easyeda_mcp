{
  "name": "@vlabsoftware/easyeda-pro-mcp",
  "version": "1.3.1",
  "mcpName": "io.github.VLab-Software/easyeda-pro-mcp",
  "description": "Independent open-source MCP server and EasyEDA Pro extension bridge for live PCB project assistance.",
  "main": "dist/index.js",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VLab-Software/easyeda_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/VLab-Software/easyeda_mcp/issues"
  },
  "homepage": "http://vlabsoft.org/easyeda_mcp/",
  "keywords": [
    "easyeda",
    "mcp",
    "model-context-protocol",
    "pcb",
    "schematic",
    "hardware"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "build/dist/easyeda_mcp_bridge.eext",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "easyeda-pro-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:extension": "esbuild extension/src/index.ts --bundle --platform=browser --format=iife --global-name=edaEsbuildExportName --outfile=extension/dist/index.js",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:extension": "node scripts/package-extension.mjs",
    "package:mcpb": "node scripts/package-mcpb.mjs",
    "prepublishOnly": "npm run package:all",
    "package:all": "npm run build && npm run build:extension && npm run package:extension && npm run package:mcpb",
    "setup:local": "npm run package:all",
    "setup:clients": "node dist/index.js setup --local",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit --rootDir . --types node",
    "test:smoke:drc": "npm run build && node scripts/smoke-drc.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.24.2",
    "eslint": "^10.14.0",
    "fs-extra": "^11.3.5",
    "globals": "^17.14.0",
    "ignore": "^7.0.5",
    "jszip": "^3.10.1",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
